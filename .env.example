GOOGLE_CLIENT_ID=99999999999-xx99x9xx9xxxxxx9x9xx9xx9xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxx9xxxx9xx9x9xx99
RECAPTCHA_SITE_KEY=9999xxxx9999xxxx9999xxxx9999xxxx9999xxxx
RECAPTCHA_SECRET_KEY=9999xxxx9999xxxx9999xxxx9999xxxx9999xxxx
OLLAMA_HOST=localhost
# Image caption models users can choose, comma-separated; the first is the default.
# medgemma:4b suits medical images (see docs/DEVELOPMENT.md).
OLLAMA_CAPTION_MODELS=moondream,medgemma:4b
# Compose downloads this multilingual model on first startup. Options: base, small,
# medium, large-v3, large-v3-turbo. Larger models require more disk and memory.
WHISPER_MODEL=base
# For running Rails outside Compose, set the CLI and model paths instead:
# WHISPER_CLI_PATH=whisper-cli
# WHISPER_MODEL_PATH=~/models/ggml-base.bin
