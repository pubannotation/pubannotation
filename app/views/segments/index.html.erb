<%= render 'path' %>

<h1>Segments</h1>

<% if @doc.segment_editable_by?(current_user) -%>
	<p><%= link_to 'Split segments', edit_doc_segment_split_path(@doc), class: 'button' %></p>
<% end -%>

<table>
	<tr>
		<th>#</th>
		<th>Start</th>
		<th>End</th>
		<th>Text</th>
		<th>Speech</th>
	</tr>
	<% @media_transcript.segments.each_with_index do |segment, index| -%>
		<tr>
			<td><%= index %></td>
			<td><%= segment_time(segment['start_ms']) %></td>
			<td><%= segment_time(segment['end_ms']) %></td>
			<td><%= segment['text'] %></td>
			<td class="speech"><%= '✓' if @media_transcript.speech_segment?(segment) %></td>
		</tr>
	<% end -%>
</table>

<%= link_to t('views.shared.back'), doc_sourcedb_sourceid_show_path(@doc.sourcedb, @doc.sourceid) %>
