<% content_for :path do -%>
  > <%= link_to t('views.paths.home'), home_path -%>
  > <%= link_to 'docs', docs_path -%>
  > <%= link_to t('views.shared.a_doc_id', sourcedb: @doc.sourcedb, sourceid: @doc.sourceid), doc_sourcedb_sourceid_show_path(@doc.sourcedb, @doc.sourceid) -%>
  > segmentation
<% end -%>

<h1>Segmentation</h1>

<%= medium_tag(@doc.medium, id: 'media-player') %>
<p>Playback time: <span id="playback-time">0:00.000 (0 ms)</span></p>

<%# Rendered by segmentations.js from the segments, which it splits and merges as Split here and Merge with next
    are pressed. %>
<div id="segmentation-segments" data-segments="<%= @media_transcript.segments.to_json(only: %i[text start_ms end_ms line_break_after]) %>"></div>

<p id="split-point">Click in a segment's text to point where to split it, or to select it to merge with the next one.</p>
<p>
  <%= button_tag 'Split here', type: 'button', id: 'split-here', class: 'button', disabled: true %>
  <%= button_tag 'Merge with next', type: 'button', id: 'merge-with-next', class: 'button', disabled: true %>
  <span id="split-error" class="error"></span>
</p>

<%# Filled by segmentations.js with the segments as split and merged, as Save is pressed. %>
<%= form_with scope: :segmentation, url: doc_segmentation_path(@doc), method: :patch, id: 'segmentation-form' do |f| %>
  <%= f.hidden_field :segments %>
  <%= hidden_field_tag :return_to, @return_to, id: nil if @return_to %>
  <p>
    <%= f.submit 'Save', id: 'save-segmentation', class: 'button', disabled: true %>
    Splits and merges are shown above until saved.
  </p>
<% end %>

<%= link_to t('views.shared.back'), @back_path %>

<% content_for :javascript do -%>
  <%= javascript_include_tag 'segmentations', defer: true -%>
<% end -%>
