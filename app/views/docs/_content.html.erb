<table style="width:100%">
<tr>
	<td class="text">
		<% if @span && @speech_segment_spans.present? %>
			<div id="body" class="with_hilight"><%= body_with_speech_segments(@doc.body, @speech_segment_spans, highlight: @span) %></div>
		<% elsif @span %>
			<div id="body" class="with_hilight"><%= @doc.highlight_span(@span).html_safe %></div>
		<% elsif @speech_segment_spans.present? %>
			<div id="body"><%= body_with_speech_segments(@doc.body, @speech_segment_spans) %></div>
		<% else %>
			<div id="body"><%= @doc.body %></div>
		<% end %>
	</td>
</tr>
<tr>
	<td id="linkSpace"></td>
</tr>
</table>

<%= link_to t('views.shared.edit_model', :model => t('activerecord.models.doc')), edit_doc_path(@doc), :class => 'button'  if @doc.updatable_for?(current_user) -%>

<% content_for :javascript do -%>
	<%= javascript_include_tag 'docs', defer: true -%>
<% end -%>
