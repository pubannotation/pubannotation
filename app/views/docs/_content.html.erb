<table style="width:100%">
<tr>
	<td class="text">
		<%= doc_body_tag(@doc, speech_segment_spans: @speech_segment_spans, selected_span: @span) %>
	</td>
</tr>
<tr>
	<td id="linkSpace"></td>
</tr>
</table>

<%= link_to t('views.shared.edit_model', :model => t('activerecord.models.doc')), edit_doc_path(@doc), :class => 'button'  if @doc.updatable_for?(current_user) -%>

<% content_for :javascript do -%>
	<%= javascript_include_tag 'docs', defer: true -%>
<% end -%>
