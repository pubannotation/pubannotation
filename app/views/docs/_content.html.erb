<table style="width:100%">
<tr>
	<td class="text">
		<% if @span %>
			<div id="body" class="with_hilight"><%= @doc.highlight_span(@span).html_safe %></div>
		<% elsif @speech_segment_spans.present? %>
			<div id="body"><%= @doc.body_with_speech_segments(@speech_segment_spans).html_safe %></div>
		<% else %>
			<div id="body"><%= @doc.body %></div>
		<% end %>
	</td>
</tr>
<tr>
	<td id="linkSpace"></td>
</tr>
</table>

<%= link_to t('views.shared.edit_model', :model => t('activerecord.models.doc')), edit_doc_path(@doc), :class => 'button'  if @doc.updatable_for?(current_user) -%>

<script>
	$('#body').linkToSelectedSpan('#linkSpace');

	<% if @speech_segment_spans.present? %>
		// Highlight whichever speech segment is playing right now.
		$(document).ready(function() {
			var mediaPlayer = document.getElementById('media-player');
			var speechSegments = document.querySelectorAll('#body .speech-segment');
			if (!mediaPlayer || speechSegments.length === 0) return;

			var currentlyPlaying = null;

			mediaPlayer.addEventListener('timeupdate', function() {
				var currentMs = mediaPlayer.currentTime * 1000;
				var active = null;

				for (var i = 0; i < speechSegments.length; i++) {
					var segment = speechSegments[i];
					if (currentMs >= Number(segment.dataset.startMs) && currentMs < Number(segment.dataset.endMs)) {
						active = segment;
						break;
					}
				}

				if (active !== currentlyPlaying) {
					if (currentlyPlaying) currentlyPlaying.classList.remove('now-playing');
					if (active) active.classList.add('now-playing');
					currentlyPlaying = active;
				}
			});
		});
	<% end %>

	<% if @span %>
		// Scroll to and focus on the highlighted span
		$(document).ready(function() {
			var highlightedSpan = $('.highlight');
			if (highlightedSpan.length > 0) {
				// Make the span focusable by adding tabindex
				highlightedSpan.attr('tabindex', '-1');
				// Scroll to the element
				highlightedSpan[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
				// Focus on the element
				highlightedSpan.focus();
			}
		});
	<% end %>
</script>
