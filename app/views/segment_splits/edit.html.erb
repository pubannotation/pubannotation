<% content_for :path do -%>
	> <%= link_to t('views.paths.home'), home_path -%>
	> <%= link_to 'docs', docs_path -%>
	> <%= link_to t('views.shared.a_doc_id', sourcedb: @doc.sourcedb, sourceid: @doc.sourceid), doc_sourcedb_sourceid_show_path(@doc.sourcedb, @doc.sourceid) -%>
	> <%= link_to 'segments', doc_segments_path(@doc) -%>
	> split
<% end -%>

<h1>Split segments</h1>

<%= medium_tag(@doc.medium, id: 'media-player') %>
<p>Playback time: <span id="playback-time">0:00.000 (0 ms)</span></p>

<p id="split-point">Click in a segment's text to point where to split it.</p>
<p>
	<%= button_tag 'Split here', type: 'button', id: 'split-here', class: 'button', disabled: true %>
	<span id="split-error" class="error"></span>
</p>
<p>Splits are shown here only; they aren't saved yet.</p>

<%# Rendered by segment_splits.js from the segments, which it splits as Split here is pressed. %>
<div id="split-segments" data-segments="<%= @media_transcript.segments.to_json %>"></div>

<%= link_to t('views.shared.back'), doc_segments_path(@doc) %>

<% content_for :javascript do -%>
	<%= javascript_include_tag 'segment_splits', defer: true -%>
<% end -%>
