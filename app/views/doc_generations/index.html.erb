<%= turbo_frame_tag 'doc_generation_status' do %>
  <% if @jobs.any? %>
    <section aria-live="polite">
      <h2>Document generation from media</h2>
      <ul>
        <% @jobs.each do |job| %>
          <li>
            <%= link_to "Job ##{job.id}", project_job_path(@project.name, job), data: { turbo_frame: '_top' } %>:
            <% if job.waiting? %>
              Waiting
            <% elsif job.running? %>
              Running
            <% elsif !job.succeeded? %>
              Failed
            <% elsif job.media_transcription_task&.media_transcript.nil? %>
              Finished: result is no longer available
            <% elsif job.media_transcription_task.media_transcript.text.blank? %>
              Finished: no text was generated; no document was created
            <% else %>
              Finished: document created
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
